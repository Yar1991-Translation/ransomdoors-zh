<Window x:Class="rans0m.CoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RANS0M" Height="96" Width="96"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        Topmost="True" WindowStartupLocation="Manual" Cursor="Hand"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Background="Transparent">
        <Image x:Name="img_coin" Width="84" Height="84" Stretch="Uniform" Source="/Assets/Gold.png"
               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <RotateTransform x:Name="coinRotation" Angle="0"/>
            </Image.RenderTransform>
            <Image.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
            </Image.Effect>
        </Image>
        <Border x:Name="valueBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                Padding="5,0,5,1" CornerRadius="7" Background="#CC000000">
            <TextBlock x:Name="txt_value" Text="" Foreground="#FFFFD24A" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>
